# Retell API key with the "webhook" badge - used to verify incoming webhook signatures.
# Find it in Retell dashboard > API Keys.
RETELL_API_KEY=

# This service's own public HTTPS URL, no trailing slash, e.g.:
# PUBLIC_BASE_URL=https://retell-production-b640.up.railway.app
# Used to set webhook_url explicitly on every agent this service creates
# (more reliable than depending on Retell's account-level webhook inheriting
# to API-created agents), and for what the admin panel displays. Without
# this set, the admin panel falls back to guessing from the request, which
# is unreliable behind Railway's reverse proxy.
PUBLIC_BASE_URL=

# Storage. Defaults to a local SQLite file; swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/retell_leads
DATABASE_URL=sqlite:///./retell_leads.db

# Any long random string. Sent as the X-Admin-Key header to manage tenants/leads.
ADMIN_API_KEY=change-me

# --- Email notifications ---
# Preferred: Postmark's API. Only needs the token + a From address (SMTP_FROM,
# reused here for the sender regardless of which path is used).
POSTMARK_API_TOKEN=
SMTP_FROM=notifications@notify.yourdomain.com
# Fallback: generic SMTP, used only if POSTMARK_API_TOKEN is blank (e.g. a
# different provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS notifications (reuses your existing Twilio account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Auto-provisioning (admin panel "add a site" with a niche selected) ---
# The one shared SIP trunk every site's Twilio number gets attached to.
# Find its SID in Twilio Console > Elastic SIP Trunks > your trunk (starts with TK).
TWILIO_TRUNK_SID=
# The termination credential list username/password you created on that trunk
# (Termination tab > Credential List). Retell uses these to authenticate.
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# Comma-separated ISO country codes allowed to call in, passed to Retell's
# import-phone-number API.
RETELL_ALLOWED_INBOUND_COUNTRIES=US,GB

# --- Social auto-provisioning ("Provision social" in the admin panel) ---
# Ayrshare (https://ayrshare.com) Business Plan master API key - manages every
# site's socials from one account via a separate "profile" per site.
AYRSHARE_API_KEY=
AYRSHARE_API_BASE=https://app.ayrshare.com/api
# Anthropic (Claude) API key - generates niche+location-varied captions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Bannerbear (https://bannerbear.com) - renders branded creative images.
# Leave blank to post text-only (a deliberate, valid setup, not a fallback).
# The template needs text layers named "caption" and "business_name", and
# optionally an image layer named "logo".
BANNERBEAR_API_KEY=
BANNERBEAR_API_BASE=https://api.bannerbear.com/v2
BANNERBEAR_TEMPLATE_UID=
# Comma-separated Ayrshare platform names, used when a niche leaves its own
# blank, e.g. facebook,instagram,linkedin,twitter. Google Business Profile
# ("gmb") is deliberately NOT a default - it requires a verified physical/
# service-area listing tied to a real, contactable business, and mass-created
# listings on rank-and-rent sites get suspended quickly. Only add "gmb" per
# niche for sites where you hold a genuine verified listing.
SOCIAL_DEFAULT_PLATFORMS=facebook,instagram
# How many upcoming posts "Provision social" tops each site's queue up to.
SOCIAL_POSTS_PER_BATCH=6
# Hours between a site's scheduled posts.
SOCIAL_POST_INTERVAL_HOURS=60
