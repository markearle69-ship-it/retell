# Retell API key with the "webhook" badge - used to verify incoming webhook signatures.
# Find it in Retell dashboard > API Keys.
RETELL_API_KEY=

# Storage. Defaults to a local SQLite file; swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/retell_leads
DATABASE_URL=sqlite:///./retell_leads.db

# Any long random string. Sent as the X-Admin-Key header to manage tenants/leads.
ADMIN_API_KEY=change-me

# --- Email notifications (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS notifications (reuses your existing Twilio account) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
