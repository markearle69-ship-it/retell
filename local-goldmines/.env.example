# Password for the single login screen (also signs the session cookie).
# Required - the app refuses every login while this is empty.
APP_PASSWORD=

# Postgres on Railway; SQLite by default for local runs.
DATABASE_URL=sqlite:///./goldmines.db

# OpenStreetMap's geocoder asks every app to identify itself with a contact email.
CONTACT_EMAIL=

# US Census API key (free) - used for US population / income / home values.
CENSUS_API_KEY=

# Used from Step 2 onwards.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
ANTHROPIC_API_KEY=
